{
  "name": "fastdo-ai-testing-automation",
  "version": "1.0.0",
  "description": "Playwright E2E automation cho quy trình AI Testing của Fastdo. Xem README.md để biết cách setup & chạy.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:local": "cross-env TEST_ENV=local playwright test",
    "test:beta": "cross-env TEST_ENV=beta playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/smoke",
    "report": "playwright show-report ../reports/playwright-report",
    "install:browsers": "playwright install chromium",
    "postinstall": "playwright install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "typescript": "^7.0.2"
  }
}
