# ==============================================================================
# Copy file này thành .env.local hoặc .env.beta rồi điền giá trị thật.
# KHÔNG commit file .env.local / .env.beta.secrets nếu chứa mật khẩu thật.
# Cách chọn file: TEST_ENV=local  -> đọc .env.local
#                 TEST_ENV=beta   -> đọc .env.beta (đã có sẵn BASE_URL mặc định, xem automation/.env.beta)
# ==============================================================================

# URL gốc của môi trường cần test
BASE_URL=http://localhost:5000

# Tài khoản đăng nhập dùng cho tests/auth.setup.ts (bỏ trống nếu chưa cần login)
# Khi điền đủ 2 biến này, Playwright sẽ tự động chạy project "setup" để đăng nhập
# 1 lần và lưu session vào playwright/.auth/user.json cho toàn bộ test dùng lại.
AUTH_USERNAME=
AUTH_PASSWORD=
